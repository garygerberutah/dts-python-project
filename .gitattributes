# Git attributes — line endings, diff drivers, and binary handling.

# ── Default: auto-detect text vs binary ──────────────────────
* text=auto eol=lf

# ── Text files: always LF ───────────────────────────────────
*.py        text eol=lf
*.js        text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.j2        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.cfg       text eol=lf

# ── Binary files: never normalize ────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.wasm      binary
*.pdf       binary
*.mp4       binary
*.mp3       binary

# ── Generated / vendored: exclude from GitHub language stats ─
ui/src/wasm/pkg/** linguist-generated
dist/**            linguist-generated
